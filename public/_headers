# Cloudflare Pages headers.
# Lives in public/, so it is copied verbatim into dist/ at build time.

# Fonts are self-hosted from /fonts and are NOT content-hashed, so they need an
# explicit immutable cache. Filenames change only when the face itself changes.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# astro:assets output is content-hashed; safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML gets a short freshness window so that prefetched pages are actually
# reusable. With max-age=0 every navigation revalidated over the network, which
# threw away the whole benefit of prefetching and roughly doubled the time from
# tap to content on a phone. 60s is long enough to cover a browsing session and
# short enough that a copy change is live almost immediately; raise or lower
# this one number to trade freshness against speed.
/*
  Cache-Control: public, max-age=60, stale-while-revalidate=600
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
