---
/**
 * Book information (§7.3) — a two-column definition list on cream, hairline
 * rules between rows, tabular numerals.
 *
 * ISBN and publication date are still pending (§14). They render the word
 * `Pending` in the same row, at the same size, so when the real values arrive
 * the layout does not shift by a pixel — the rule from §10.
 */
import Section from '@/components/layout/Section.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import { site, PENDING_LABEL } from '@/config/site';

/**
 * A row whose value may not have arrived yet. Pending values render the word
 * `Pending` in the same row at the same size, so the real value lands with no
 * layout shift (§10).
 */
const row = (label: string, value: string | number | null) => ({
  label,
  value: value === null ? PENDING_LABEL : String(value),
  pending: value === null,
});

/**
 * This is the book being catalogued rather than displayed, so the Title row
 * carries the formal title. The hero lockup above keeps the cover treatment.
 */
const rows = [
  row('Title', site.book.fullTitle),
  row('Volume', site.book.volume),
  row('Author', site.book.author),
  row('Publisher', site.book.publisher),
  row('Format', site.book.format),
  row('Distribution', site.book.distribution),
  row('Pages', site.book.pages),
  row('Language', site.book.language),
  row('Price', site.book.price),
  row('ISBN', site.book.isbn),
  row('Publication Date', site.book.publicationDate),
];
---

<Section tone="cream" labelledby="book-info-title" class="bookinfo" line={false}>
  <div class="bookinfo__wrap" data-reveal>
    <Eyebrow as="div"><h2 id="book-info-title" class="bookinfo__title">Book Information</h2></Eyebrow>

    <dl class="bookinfo__list">
      {
        rows.map((row) => (
          <div class="bookinfo__row">
            <dt class="bookinfo__label">{row.label}</dt>
            <dd class="bookinfo__value" data-pending={row.pending ? '' : undefined}>
              {row.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</Section>

<style>
  .bookinfo__wrap { max-width: 46rem; }

  .bookinfo__title {
    font: inherit;
    color: inherit;
    margin: 0;
  }

  .bookinfo__list {
    margin-block-start: clamp(1.75rem, 4vh, 2.5rem);
    border-block-start: 1px solid var(--room-rule);
  }

  .bookinfo__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem;
    padding-block: clamp(0.85rem, 2vh, 1.15rem);
    border-block-end: 1px solid var(--room-rule);
  }

  .bookinfo__label {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-utility);
    color: var(--room-mute);
  }

  .bookinfo__value {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--step-0);
    line-height: 1.4;
    color: var(--room-text);
    /* Page counts and prices line up column-wise (§6.3). */
    font-variant-numeric: tabular-nums;
  }

  /* Same row, same size, no layout shift when the value lands. */
  .bookinfo__value[data-pending] { color: var(--room-mute); }

  @media (min-width: 700px) {
    .bookinfo__row {
      grid-template-columns: 14rem 1fr;
      gap: 0 2rem;
      align-items: baseline;
    }
  }

  @media (min-width: 900px) {
    /* Stop on the meeting line, the same place every other block that sits
       left of the axis stops. At a flat 46rem the hairline rules ran past the
       line and ended a hundred-odd pixels beyond it, which read as the table
       having been cut off rather than placed. The longest value —
       "Island Meets Italy Inc. Publishing" — still sets on one line. */
    .bookinfo__wrap {
      max-width: calc(50% - clamp(1.75rem, 4vw, 3.5rem));
    }
  }
</style>
