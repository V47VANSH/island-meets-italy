---
/**
 * Food feature (§7.1) — a cream room, because the branzino is on a white plate.
 *
 * The signature dish at large scale, bleeding off the left edge and crossing
 * the meeting line, with the four dish names as a typographic list beside it.
 * Supporting text stays minimal, per the client's instruction to let the
 * photography carry this section.
 *
 * The heading carries the eyebrow treatment rather than sitting above a second
 * heading — the approved copy gives one line here, and inventing a second would
 * be writing copy. Gold would fail contrast on cream, so the accent resolves to
 * --gold-deep through the room (§6.2).
 *
 * NOTE on §7.1's "display face at --step-1" for the dish names: §6.3 sets a
 * floor of --step-3 for the display face. The page-level instruction is the
 * more specific one and is followed here; at ~25px in a narrow editorial
 * column the face still reads as type, not decoration.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Section from '@/components/layout/Section.astro';

const dishes = (await getCollection('dishes')).sort(
  (a, b) => a.data.order - b.data.order,
);

// The light-plate dish flagged `featured` leads this cream room. Data, not
// markup, decides — adding a fifth dish never touches this file.
const lead =
  dishes.filter((d) => d.data.plateTone === 'light' && d.data.featured)[0] ??
  dishes[0];
---

<Section tone="cream" labelledby="food-title" bleed class="food">
  <div class="food__grid">
    <figure class="food__figure" data-reveal>
      <Image
        src={lead.data.image}
        alt={lead.data.alt}
        widths={[480, 800, 1080]}
        sizes="(min-width: 900px) 62vw, 100vw"
        loading="lazy"
        class="food__image"
      />
    </figure>

    <div class="food__meta">
      <h2 class="food__title" id="food-title" data-reveal>
        From the Island Meets Italy Kitchen
      </h2>

      <ul class="food__list" data-reveal style="--reveal-delay: calc(var(--stagger) * 1)">
        {
          dishes.map((dish) => (
            <li class="food__item">
              <a class="food__link" href={`/gallery#${dish.id}`}>
                <span class="food__name display">{dish.data.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>

<style>
  /* ── Mobile (base) ──────────────────────────────────────────────────── */

  .food__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vh, 3.5rem);
  }

  .food__figure { margin: 0; }

  .food__image {
    width: 100%;
    aspect-ratio: var(--photo-portrait);
    object-fit: cover;
    object-position: center;
  }

  .food__meta { padding-inline: var(--gutter); }

  /* Heading in the eyebrow treatment — --gold-deep on cream (§6.2, §7.1). */
  .food__title {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-utility);
    line-height: 1.3;
    color: var(--room-accent);
  }

  .food__list {
    margin-block-start: clamp(1.75rem, 4vh, 2.5rem);
    border-block-start: 1px solid var(--room-rule);
  }

  .food__item { border-block-end: 1px solid var(--room-rule); }

  .food__link {
    display: block;
    padding-block: clamp(0.9rem, 2vh, 1.3rem);
    text-decoration: none;
    color: var(--room-text);
    transition: color var(--dur-link) var(--ease-signature);
  }
  .food__link:hover { color: var(--room-accent); }

  .food__name {
    display: block;
    font-size: var(--step-1);
    line-height: 1.25;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }

  /* ── Desktop: enters from the left, crossing the axis (§6.1) ────────── */

  @media (min-width: 900px) {
    .food__grid {
      /* The photograph bleeds off the left edge and runs past the meeting
         line; the list sits in the remaining column, right of it. */
      grid-template-columns: 62vw minmax(17rem, 1fr);
      gap: clamp(2rem, 4vw, 4.5rem);
      align-items: center;
      padding-inline-end: var(--edge-x);
    }

    .food__meta { padding-inline: 0; }

    .food__image { aspect-ratio: var(--photo-portrait); }
  }
</style>
