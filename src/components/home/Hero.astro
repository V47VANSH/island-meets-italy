---
/**
 * Hero (§7.1) — the thesis and the signature working together.
 *
 * The official wordmark replaces the Fraunces-typeset ISLAND / MEETS / ITALY
 * that stood in before the brand assets existed. That treatment invented a
 * lockup; David had already made one, and his has the script "meets" sitting
 * between the two serif words — precisely the gesture the placeholder was
 * imitating.
 *
 * So the wordmark is positioned by its "meets" rather than by its own centre:
 * the script lands on the meeting line and "Island" and "Italy" fall either
 * side of it, exactly as §6.1 describes. The signature and the brand are now
 * the same object.
 *
 * Mobile is the base layout, not a reduction (§6.4): photograph full-bleed
 * across the top at ~55svh, the wordmark beneath it, then the copy.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Section from '@/components/layout/Section.astro';
import Button from '@/components/ui/Button.astro';
import Wordmark from '@/components/brand/Wordmark.astro';
import Tagline from '@/components/brand/Tagline.astro';

const dishes = await getCollection('dishes');
// Hero art direction is data-driven: the dark-plate dish flagged `featured`
// with the lowest order. Changing the hero photograph is a content edit.
const heroDish =
  dishes
    .filter((d) => d.data.plateTone === 'dark' && d.data.featured)
    .sort((a, b) => a.data.order - b.data.order)[0] ?? dishes[0];
---

<Section tone="ink" labelledby="hero-title" bleed flush="both" lineCap="top" class="hero">
  <div class="hero__grid" data-hero>
    <figure class="hero__figure">
      <Image
        src={heroDish.data.image}
        alt={heroDish.data.alt}
        widths={[480, 640, 800, 1080]}
        {/* Capped below 100vw on purpose: at 360px/DPR 2.6 the browser would
            pull the 1080 variant, and this is a shallow-depth-of-field frame
            where 800px across a 360px element is already past visible. It is
            the LCP element, so the bytes matter more than the last 20%. */}
        sizes="(min-width: 900px) 34rem, 800px"
        loading="eager"
        fetchpriority="high"
        class="hero__image"
      />
    </figure>

    {/* The <h1> carries the real string; the artwork is decorative. */}
    <h1 class="hero__wordmark" id="hero-title">
      <span class="visually-hidden">Island Meets Italy</span>
      <Wordmark />
    </h1>

    <div class="hero__copy">
      <div class="hero__taglinewrap"><Tagline /></div>

      <p class="hero__journey utility">
        Jamaican soul. Italian tradition. One culinary journey.
      </p>

      <p class="hero__intro prose">
        Created by Chef Kenton Lowrie, Island Meets Italy brings together the
        bold flavours of Jamaica and the timeless traditions of Italian cuisine
        through food built on strong foundations, quality ingredients and
        genuine passion.
      </p>

      <div class="hero__actions">
        <Button href="/cookbook" variant="filled">Explore the Cookbook</Button>
        <Button href="/about" variant="outlined">Meet Chef Kenton</Button>
      </div>
    </div>
  </div>
</Section>

<style>
  /* ── Hero load sequence — the one choreographed moment (§6.6) ────────
     1. the gold rule draws downward            900ms   (MeetingLine)
     2. the wordmark resolves                   900ms
     3. the photograph reveals by clip-path     900ms from +200ms
     4. tagline and buttons fade up             from +460ms

     Gated on js-reveal, which Base only sets when the viewer has not asked for
     reduced motion — so under `prefers-reduced-motion: reduce` none of this
     applies and the hero paints at final state on the first frame. */

  :global(html.js-reveal) [data-hero] :is(.hero__wordmark, .hero__figure, .hero__copy > *) {
    opacity: 0;
  }

  :global(html.js-reveal.hero-lit) [data-hero] .hero__wordmark {
    animation: hero-mark 900ms var(--ease-signature) 120ms both;
  }
  :global(html.js-reveal.hero-lit) [data-hero] .hero__figure {
    animation: hero-image 900ms var(--ease-signature) 200ms both;
  }
  :global(html.js-reveal.hero-lit) [data-hero] .hero__copy > * {
    animation: hero-rise 700ms var(--ease-signature) both;
  }
  :global(html.js-reveal.hero-lit) [data-hero] .hero__copy > :nth-child(1) { animation-delay: 460ms; }
  :global(html.js-reveal.hero-lit) [data-hero] .hero__copy > :nth-child(2) { animation-delay: 540ms; }
  :global(html.js-reveal.hero-lit) [data-hero] .hero__copy > :nth-child(3) { animation-delay: 620ms; }
  :global(html.js-reveal.hero-lit) [data-hero] .hero__copy > :nth-child(4) { animation-delay: 700ms; }

  @keyframes hero-mark {
    from { opacity: 0; transform: translateY(10px) scale(0.985); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes hero-image {
    from { opacity: 0; clip-path: inset(0 0 100% 0); }
    to   { opacity: 1; clip-path: inset(0 0 0 0); }
  }
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js-reveal) [data-hero] :is(.hero__wordmark, .hero__figure, .hero__copy > *) {
      opacity: 1;
      animation: none;
    }
  }

  /* ── Mobile (base) ──────────────────────────────────────────────────── */

  /* Header clearance sits on the grid, not the section: Section owns section
     padding, and a child setting padding-block on the same element is a
     specificity coin-toss with .section--flush-*. */
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    padding-inline: var(--gutter);
    padding-block: var(--header-h) clamp(3rem, 8vh, 4.5rem);
  }

  .hero__figure { margin: 0 calc(var(--gutter) * -1); }

  .hero__image {
    width: 100vw;
    max-width: none;
    height: 55svh;
    object-fit: cover;
    /* The fusion is visible in the cut arancino — Sicilian rice ball, Jamaican
       oxtail inside — so the crop favours it and the marinara ramekin, which is
       also the sharpest part of a shallow-depth-of-field frame. */
    object-position: 52% 68%;
  }

  .hero__wordmark {
    /* Gold on ink. Set here, on the element this component owns — the class
       handed to <Wordmark> lands on that component's own span and carries its
       scope id, so a rule for it here would silently never match. */
    color: var(--gold);
    padding-block-start: clamp(2rem, 6vh, 3rem);
  }
  .hero__wordmark :global(.wordmark) { width: 100%; }

  .hero__copy { padding-block-start: 1.75rem; }

  .hero__taglinewrap :global(.tagline) { font-size: var(--step-1); }

  .hero__journey {
    margin-block-start: 1.5rem;
    color: var(--room-accent);
  }

  .hero__intro {
    margin-block-start: 1.5rem;
    color: var(--room-mute);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: clamp(2rem, 4vh, 2.75rem);
  }
  .hero__actions > :global(.btn) { flex: 1 1 14rem; }

  /* ── Desktop: the split hero (§7.1) ─────────────────────────────────── */

  @media (min-width: 900px) {
    .hero__grid {
      min-height: 100svh;
      /* The column boundary IS the meeting line. */
      grid-template-columns: var(--axis-x) 1fr;
      grid-template-rows: auto minmax(0, 1fr);
      align-content: start;
      padding-inline: 0;
      padding-block: calc(var(--header-h) + clamp(0.5rem, 2vh, 1.25rem)) 0;
    }

    /* Full width, then nudged so the script "meets" — which sits right of
       centre inside the lockup — lands on the axis rather than the lockup's
       own midpoint. */
    .hero__wordmark {
      grid-column: 1 / -1;
      grid-row: 1;
      display: flex;
      justify-content: center;
      padding-block-start: 0;
      padding-inline: var(--edge-x);
    }
    .hero__wordmark :global(.wordmark) {
      width: min(100%, 56rem);
      transform: translateX(-7.6%);
    }

    .hero__copy {
      grid-column: 1;
      grid-row: 2;
      /* Starts under the wordmark rather than centring in a tall row — the
         tagline belongs to the mark above it, and centring opened a gap the
         size of a section between the two. */
      align-self: start;
      padding-inline: var(--edge-x) clamp(1.5rem, 4vw, 4rem);
      padding-block: clamp(2.5rem, 7vh, 4.5rem) clamp(2rem, 5vh, 3.5rem);
    }

    .hero__taglinewrap :global(.tagline) { font-size: var(--step-1); }
    .hero__intro { max-width: 46ch; }
    .hero__actions > :global(.btn) { flex: 0 0 auto; }

    .hero__figure {
      grid-column: 2;
      grid-row: 2;
      justify-self: end;
      align-self: end;
      margin: 0;
      padding: 0;
      /* Height is bound to the viewport, not the grid row: the row has no
         definite height, so `height: 100%` would resolve to auto, the
         aspect-ratio would derive height from max-width, and the row would
         grow to fit it — inflating the hero past one viewport. */
      height: clamp(20rem, 54svh, 40rem);
      aspect-ratio: var(--photo-portrait);
      max-width: 100%;
    }

    .hero__image {
      width: 100%;
      max-width: 100%;
      height: 100%;
      object-position: 52% 68%;
    }
  }
</style>

<script>
  /**
   * Fires the hero load sequence by adding `hero-lit` to <html> after the
   * first paint, so the animations have a frame to start from. Gated on
   * js-reveal, which is absent under prefers-reduced-motion.
   */
  function litHero() {
    const root = document.documentElement;
    if (!root.classList.contains('js-reveal')) return;
    root.classList.remove('hero-lit');
    if (!document.querySelector('[data-hero]')) return;
    requestAnimationFrame(() => {
      requestAnimationFrame(() => root.classList.add('hero-lit'));
    });
  }

  litHero();
  document.addEventListener('astro:page-load', litHero);
</script>
