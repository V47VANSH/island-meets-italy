---
/**
 * MeetingLine — the signature (§6.1).
 *
 * A single gold hairline running vertically down the page: the brand's thesis
 * (two things converging) said structurally rather than in words. Sections
 * alternate which side they enter from, so the eye crosses it repeatedly.
 * This is the one bold element on the site. There is no second one.
 *
 * Rendered as one full-height segment per section, at --axis-x. Sections are
 * contiguous, so the segments read as a single unbroken rule from the top of
 * the page to the footer, scrolling with the content as a spine should.
 *
 * DEVIATION from §6.1's implementation note, which asks for a fixed-position
 * element below all sections. That cannot work here: §6.4 alternates opaque ink
 * and cream backgrounds, which would paint over a line sitting beneath them,
 * and --gold at 0.28 is invisible on cream anyway (§6.2 forbids gold on light).
 * Per-section rendering keeps every stated requirement — continuous, behind
 * content, pointer-events: none, unbroken on scroll — and additionally lets the
 * line take a legible colour in each room.
 *
 * On mobile --axis-x moves to the left gutter and the line becomes a scroll
 * spine (§6.4).
 */
interface Props {
  /** Fade the top or bottom of the segment, for the first and last sections. */
  cap?: 'none' | 'top' | 'bottom' | 'both';
}
const { cap = 'none' } = Astro.props;
---

<span class:list={['meeting-line', `meeting-line--cap-${cap}`]} aria-hidden="true"></span>

<style>
  .meeting-line {
    position: absolute;
    inset-block: 0;
    left: var(--axis-x);
    width: 1px;
    /* --room-line resolves to gold on ink, gold-deep on cream. */
    background: var(--room-line);
    pointer-events: none;
    z-index: 1;

    /* Fade across exactly the section's vertical rhythm, so the rule marks the
       band where the two columns actually face each other and is gone through
       the padding above and below them. Section publishes these; its flush
       modifiers zero them, so a hero that pays no padding keeps a solid line.

       Percentages could not do this: on a 348px section with 129px of padding
       each end, the content band is only the middle quarter, and a percentage
       fade left the rule running at full strength through both bands. */
    --fade-top: var(--line-fade-start, 0px);
    --fade-bottom: var(--line-fade-end, 0px);
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 var(--fade-top),
      #000 calc(100% - var(--fade-bottom)),
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 var(--fade-top),
      #000 calc(100% - var(--fade-bottom)),
      transparent 100%
    );
  }

  /* Below the desktop breakpoint every section stacks to one column, so there
     is nothing for the rule to divide: --axis-x moves to the left gutter and
     it becomes a hairline 14px from the screen edge, which reads as a stray
     border on the section rather than as the brand's spine — most obviously
     on the cream rooms, where a warm line sits against a light ground. The
     alternating ink and cream rooms already partition the page there. */
  @media (max-width: 899px) {
    .meeting-line { display: none; }
  }

  /* Step 1 of the hero sequence: the rule draws downward (§6.6). Only the
     hero's own segment animates; the rest of the page's line is already
     there. Gated on js-reveal, so reduced motion never sees it. */
  :global(html.js-reveal) :global(.hero) .meeting-line {
    transform: scaleY(0);
    transform-origin: top center;
  }
  :global(html.js-reveal.hero-lit) :global(.hero) .meeting-line {
    transform: scaleY(1);
    transition: transform 900ms var(--ease-signature);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js-reveal) :global(.hero) .meeting-line {
      transform: none;
      transition: none;
    }
  }

  /* Caps fade the first and last segment on a page, on top of whatever the
     section's own rhythm already contributes. */
  .meeting-line--cap-top { --fade-top: max(var(--line-fade-start, 0px), 5rem); }
  .meeting-line--cap-bottom { --fade-bottom: max(var(--line-fade-end, 0px), 5rem); }
  .meeting-line--cap-both {
    --fade-top: max(var(--line-fade-start, 0px), 5rem);
    --fade-bottom: max(var(--line-fade-end, 0px), 5rem);
  }
</style>
