---
/**
 * Eyebrow — the small tracked label above a section heading (§6.3).
 * Gold on ink, gold-deep on cream, resolved by the room. Renders as a <p> by
 * default so it never competes with the heading outline.
 */
interface Props {
  as?: 'p' | 'span' | 'div';
  class?: string;
}
const { as: Tag = 'p', class: className = '' } = Astro.props;
---

<Tag class:list={['eyebrow', className]}><slot /></Tag>

<style>
  .eyebrow {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-utility);
    line-height: 1.3;
    color: var(--room-accent);
  }
</style>
