---
/**
 * About (§7.2).
 *
 * Four sections, no images except the author photograph at the top and the
 * Mango Caprese as the one light-room accent between sections 2 and 3.
 *
 * "The Philosophy" is the emotional centre of the page, so it gets a cream
 * room, --room-emphasis (maroon) and the most space on the page.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Section from '@/components/layout/Section.astro';
import Button from '@/components/ui/Button.astro';
import ChefPortrait from '@/components/ui/ChefPortrait.astro';
import { site } from '@/config/site';

const dishes = await getCollection('dishes');
const caprese = dishes.find((d) => d.id === 'mango-caprese')!;

const title = 'About Chef Kenton Lowrie — Island Meets Italy';
const description =
  'Chef Kenton Lowrie is a professional chef, author and founder of Island Meets Italy, bringing together the flavours of Jamaica and Italian tradition.';
---

<Base
  title={title}
  description={description}
  ogImage="/og/about.jpg"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'About', href: '/about' }]}
>
  {/* 1 — A Career Built in the Kitchen: author photo, two paragraphs */}
  <Section tone="ink" labelledby="career-title" class="career">
    <div class="career__grid">
      <ChefPortrait
        treatment="ink"
        sizes="(min-width: 900px) 30vw, 70vw"
        loading="eager"
        class="career__portrait"
      />

      <div class="career__copy">
        <div data-reveal>
          <h1 class="career__title display" id="career-title">
            A Career Built in the Kitchen
          </h1>
          <p class="career__role utility">{site.chef.title}</p>
        </div>

        <div data-reveal style="--reveal-delay: calc(var(--stagger) * 1)">
          <p class="prose">
            Chef Kenton Lowrie is a professional chef, author and founder of
            Island Meets Italy, a culinary brand bringing together the vibrant
            flavours of Jamaica and the timeless traditions of Italian cuisine.
          </p>
          <p class="prose">
            With more than 20 years of experience in professional kitchens,
            Kenton has built his career through hands-on cooking, recipe
            development, menu creation, leadership and a commitment to
            consistency. His professional experience was further strengthened
            through Culinary Management studies at Humber College.
          </p>
        </div>
      </div>
    </div>
  </Section>

  {/* 2 — The Story Behind Island Meets Italy: offset across the rule */}
  <Section tone="ink" labelledby="story-title" class="story">
    <div class="story__grid">
      <div class="story__headingwrap" data-reveal>
        <h2 class="story__title display" id="story-title">
          The Story Behind Island Meets Italy
        </h2>
      </div>

      <div class="story__body" data-reveal style="--reveal-delay: calc(var(--stagger) * 1)">
        <p class="prose">
          Island Meets Italy grew from Kenton's own culinary identity. His
          Jamaican heritage gave him an appreciation for bold seasoning, layered
          flavour, warmth and the importance of food in bringing people
          together. His professional culinary journey developed alongside a deep
          appreciation for Italian cuisine — its techniques, ingredients,
          traditions and respect for simplicity.
        </p>
        <p class="prose">
          Rather than forcing two cuisines together, Kenton's approach is to
          understand what makes each one distinctive and find the places where
          they naturally complement one another. The result is food that can
          feel familiar and unexpected at the same time: island soul meeting
          Italian heart.
        </p>
      </div>
    </div>
  </Section>

  {/* The one light-room accent, between sections 2 and 3 (§7.2) */}
  <Section tone="cream" class="accent">
    <figure class="accent__figure" data-reveal>
      <Image
        src={caprese.data.image}
        alt={caprese.data.alt}
        widths={[600, 900, 1080]}
        sizes="(min-width: 900px) 78vw, 100vw"
        loading="lazy"
        class="accent__img"
      />
    </figure>
  </Section>

  {/* 3 — The Philosophy: the emotional centre, given the most room */}
  <Section tone="cream" labelledby="philosophy-title" class="philosophy">
    <div class="philosophy__wrap">
      <h2 class="philosophy__title display" id="philosophy-title" data-reveal>
        The Philosophy
      </h2>

      <p
        class="philosophy__lead display"
        data-reveal
        style="--reveal-delay: calc(var(--stagger) * 1)"
      >
        For Kenton, exceptional cooking begins with strong foundations:
        understanding technique, respecting ingredients, building flavour
        properly, being consistent, and taking pride in what leaves the kitchen.
      </p>

      <p
        class="philosophy__coda prose"
        data-reveal
        style="--reveal-delay: calc(var(--stagger) * 2)"
      >
        That philosophy became the foundation for Island Meets Italy and Volume
        1 — Foundations of Flavor.
      </p>
    </div>
  </Section>

  {/* 4 — More Than a Cookbook */}
  <Section tone="ink" labelledby="more-title" class="more">
    <div class="more__grid">
      <div class="more__headingwrap" data-reveal>
        <h2 class="more__title display" id="more-title">More Than a Cookbook</h2>
      </div>

      <div class="more__body">
        <p class="prose" data-reveal style="--reveal-delay: calc(var(--stagger) * 1)">
          Island Meets Italy begins with publishing, but the vision extends
          beyond the first cookbook. Future cookbook volumes, premium food
          products and ultimately an Island Meets Italy restaurant form part of
          the larger culinary vision.
        </p>

        <div class="more__actions" data-reveal style="--reveal-delay: calc(var(--stagger) * 2)">
          <Button href="/cookbook" variant="outlined">Discover the Cookbook</Button>
        </div>
      </div>
    </div>
  </Section>
</Base>

<style>
  /* ── 1. Career ──────────────────────────────────────────────────────── */

  .career__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 4vh, 2.5rem);
    /* First block on the page: clear the fixed header here rather than on the
       Section, whose scope id this file cannot reach. */
    padding-block-start: var(--header-h);
  }

  .career__portrait {
    width: min(70%, 18rem);
  }

  .career__title {
    font-size: var(--step-4);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .career__role {
    margin-block-start: 1.1rem;
    color: var(--room-accent);
  }

  .career__copy > :global(* + *) { margin-block-start: clamp(1.5rem, 3vh, 2rem); }
  .career__copy :global(.prose) { color: var(--room-mute); }
  .career__copy :global(.prose + .prose) { margin-block-start: 1.35em; }

  /* ── 2. Story ───────────────────────────────────────────────────────── */

  .story__grid,
  .more__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vh, 3rem) 0;
  }

  .story__title,
  .more__title {
    font-size: var(--step-3);
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .story__body :global(.prose),
  .more__body :global(.prose) { color: var(--room-mute); }
  .story__body :global(.prose + .prose) { margin-block-start: 1.35em; }

  .more__actions { margin-block-start: clamp(2rem, 4vh, 2.75rem); }

  /* ── Accent ─────────────────────────────────────────────────────────── */

  .accent__figure {
    margin: 0;
    /* Not full-bleed: the source is 1080px wide, so a 100vw band would be
       upscaled almost 2x on a large screen. Contained, it stays close to 1:1. */
  }

  .accent__img {
    width: 100%;
    /* A deliberate detail band rather than a record of the whole plate — the
       gallery shows that. §5.2 warns these portrait frames crop badly wide,
       and it is right for the hero; here the diagonal arrangement of mango,
       mozzarella and pea shoots survives a tight horizontal band intact. */
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center 55%;
  }

  /* ── 3. Philosophy ──────────────────────────────────────────────────── */

  .philosophy__wrap { max-width: 40rem; }

  .philosophy__title {
    font-size: var(--step-3);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }

  .philosophy__lead {
    margin-block-start: clamp(1.75rem, 4vh, 2.5rem);
    font-size: var(--step-2);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--room-emphasis);
    text-wrap: pretty;
  }

  .philosophy__coda {
    margin-block-start: clamp(1.75rem, 4vh, 2.5rem);
    color: var(--room-mute);
  }

  /* ── Desktop ────────────────────────────────────────────────────────── */

  @media (min-width: 900px) {
    .career__grid {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 0;
    }

    .career__portrait {
      grid-column: 1;
      justify-self: end;
      width: min(100%, 24rem);
      padding-inline-end: clamp(1.75rem, 4vw, 3.5rem);
    }

    .career__copy {
      grid-column: 2;
      padding-inline-start: clamp(1.75rem, 4vw, 3.5rem);
    }

    /* Sections 2 and 4 alternate which side of the rule they enter from. */
    .story__grid,
    .more__grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .story__headingwrap {
      grid-column: 1;
      justify-self: end;
      text-align: right;
      padding-inline-end: clamp(1.75rem, 4vw, 3.5rem);
    }
    .story__body {
      grid-column: 2;
      padding-inline-start: clamp(1.75rem, 4vw, 3.5rem);
      padding-block-start: clamp(0.5rem, 2vh, 1.5rem);
    }

    /* Section 4 mirrors it: copy left, heading right. */
    .more__headingwrap {
      grid-column: 2;
      grid-row: 1;
      padding-inline-start: clamp(1.75rem, 4vw, 3.5rem);
    }
    .more__body {
      grid-column: 1;
      grid-row: 1;
      justify-self: end;
      text-align: right;
      padding-inline-end: clamp(1.75rem, 4vw, 3.5rem);
    }
    .more__body :global(.prose) { margin-inline-start: auto; }
    .more__actions { display: flex; justify-content: flex-end; }

    .accent__figure {
      /* Enters from the left, opposite to the section above it (§6.1). */
      width: 78%;
    }
    .accent__img { aspect-ratio: 21 / 9; }

    .philosophy__wrap {
      /* Offset right of the rule, so the page's quietest moment still sits
         off-centre (§6.7). */
      margin-inline-start: 50%;
      padding-inline-start: clamp(1.75rem, 4vw, 3.5rem);
      max-width: none;
    }
    .philosophy__lead { max-width: 30ch; }
    .philosophy__coda { max-width: 42ch; }
  }
</style>
