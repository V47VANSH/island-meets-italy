---
/**
 * Gallery (§7.4).
 *
 * Two dishes to a room, not one to a page.
 *
 * One dish per full-width section could not work with these photographs. They
 * are 3:4 portraits from 1080px-wide originals, so a frame that fits the
 * viewport height is necessarily narrow — and a narrow object in a full-width
 * section leaves half the screen empty. Sized to fill the width instead, each
 * one ran half a screen taller than the viewport and could never be seen
 * whole. The layout has to stop asking one portrait photograph to carry a
 * widescreen row.
 *
 * Pairing solves it without breaking anything: the plate tones split exactly
 * two and two, so grouping by tone puts two dishes in every room while every
 * dish still lands on the ground §5.2 chose for it — white plates on cream,
 * dark plates on ink. Each room is then an asymmetric pair (§7.4 asks for an
 * editorial grid, explicitly not four equal tiles): a large squarer frame and
 * a smaller portrait one dropped below it, and the two rooms mirror each
 * other so the weight alternates down the page.
 *
 * Aspect ratios are chosen per role rather than left at the native 3:4. The
 * large frame is square so that widening it does not also make it taller than
 * the screen; the small one stays portrait, where its height costs nothing.
 * Both are crops of the original, never upscales.
 *
 * Anchor ids come from the collection entry ids, which the homepage dish list
 * links to: #branzino, #mango-caprese, #oxtail-arancini, #panna-cotta.
 *
 * Mobile is one dish per viewport, full-bleed, name beneath — designed, not
 * the desktop grid squeezed (§6.4).
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageIntro from '@/components/layout/PageIntro.astro';
import Section from '@/components/layout/Section.astro';

const dishes = (await getCollection('dishes')).sort(
  (a, b) => a.data.order - b.data.order,
);

/**
 * Grouped by plate tone, so the room each dish lands in is still the one its
 * photograph was shot for. Order within a group is the collection order, so
 * the signature dish leads its room; a fifth dish joins whichever group its
 * own plate tone puts it in and takes the smaller role.
 */
const rooms = (
  [
    { tone: 'cream' as const, plate: 'light' as const },
    { tone: 'ink' as const, plate: 'dark' as const },
  ]
)
  .map((room) => ({
    ...room,
    dishes: dishes.filter((d) => d.data.plateTone === room.plate),
  }))
  .filter((room) => room.dishes.length > 0);

const title = 'Gallery — From the Island Meets Italy Kitchen';
const description =
  'Jamaican soul. Italian tradition. Food by Chef Kenton Lowrie — whole branzino, mango caprese, oxtail arancini and lime & coconut panna cotta.';
---

<Base
  title={title}
  description={description}
  ogImage="/og/gallery.jpg"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Gallery', href: '/gallery' }]}
>
  <PageIntro title="From the Island Meets Italy Kitchen">
    <p class="prose">Jamaican soul. Italian tradition. Food by Chef Kenton Lowrie.</p>
  </PageIntro>

  {
    rooms.map((room, roomIndex) => (
      <Section tone={room.tone} line={false}>
        <div class="plate" data-lead={roomIndex % 2 === 0 ? 'start' : 'end'}>
          {room.dishes.map((dish, i) => {
            const role = i === 0 ? 'lead' : 'counter';
            return (
              <figure class="dish" id={dish.id} data-role={role} data-reveal>
                <Image
                  src={dish.data.image}
                  alt={dish.data.alt}
                  widths={[420, 640, 860, 1080]}
                  sizes={
                    role === 'lead'
                      ? '(min-width: 900px) 56vw, 100vw'
                      : '(min-width: 900px) 31vw, 100vw'
                  }
                  loading={roomIndex === 0 && i === 0 ? 'eager' : 'lazy'}
                  class="dish__img"
                />
                <figcaption class="dish__caption">
                  <span class="dish__rule" aria-hidden="true" />
                  <span class="dish__name display">{dish.data.name}</span>
                </figcaption>
              </figure>
            );
          })}
        </div>
      </Section>
    ))
  }
</Base>

<style>
  /* ── Mobile: one dish per viewport, full-bleed ──────────────────────── */

  .plate { display: grid; }

  .dish {
    margin: 0;
    /* Anchored from the homepage dish list — clear the fixed header. */
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .dish + .dish { margin-block-start: clamp(3rem, 8vh, 4.5rem); }

  .dish__img {
    /* global.css caps every image at max-width:100%, which is the container
       width here — that silently clipped the bleed. This one is on the image
       itself, so the cap has to be lifted explicitly. Derived from the
       padding it cancels rather than from 100vw, which on Windows is a
       scrollbar wider than the page. */
    max-width: none;
    width: calc(100% + var(--edge-x) * 2);
    margin-inline: calc(var(--edge-x) * -1);
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center;
  }

  .dish__caption { display: block; }

  /* The double hairline from the cookbook cover, not a generic rule. */
  .dish__rule {
    display: block;
    width: 100%;
    height: 3px;
    margin-block: clamp(1.25rem, 3vh, 1.75rem) clamp(0.9rem, 2vh, 1.25rem);
    border-block: 1px solid var(--room-rule);
  }

  .dish__name {
    display: block;
    font-size: var(--step-1);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--room-text);
    text-wrap: balance;
  }

  /* ── Desktop: an asymmetric pair to a room ──────────────────────────── */

  @media (min-width: 900px) {
    .plate {
      grid-template-columns: 1.32fr 0.68fr;
      column-gap: clamp(1.5rem, 3vw, 3rem);
      align-items: start;
    }

    /* The second room mirrors the first, so the weight alternates. */
    .plate[data-lead='end'] { grid-template-columns: 0.68fr 1.32fr; }
    .plate[data-lead='end'] .dish[data-role='lead'] { grid-column: 2; grid-row: 1; }
    .plate[data-lead='end'] .dish[data-role='counter'] { grid-column: 1; grid-row: 1; }

    .dish + .dish { margin-block-start: 0; }

    .dish__img {
      width: 100%;
      max-width: 100%;
      margin-inline: 0;
    }

    /* Square, not the native 3:4: the large frame has to widen to fill its
       column, and at 3:4 widening it also makes it taller than the viewport.
       Square lets it take the width and still be seen whole. */
    .dish[data-role='lead'] .dish__img { aspect-ratio: 1 / 1; }

    /* Dropped down the column, so the pair reads as a composition rather than
       as two tiles flush to a line. Portrait costs nothing at this width.

       Qualified with .plate to outrank the `.dish + .dish` reset above it:
       Astro scopes every compound, so that sibling selector carries two
       class-plus-attribute compounds and wins a same-specificity tie the
       source order would otherwise decide. */
    .plate .dish[data-role='counter'] {
      margin-block-start: clamp(3rem, 11vw, 8rem);
    }
    .dish[data-role='counter'] .dish__img { aspect-ratio: 4 / 5; }

    .dish[data-role='lead'] .dish__name { font-size: var(--step-2); }
  }
</style>
