---
/**
 * Gallery (§7.4).
 *
 * Desktop is an asymmetric editorial grid, not four equal tiles: the branzino
 * is the signature dish and runs largest, the others step down and alternate
 * which side of the meeting line they sit on. Mobile is one dish per viewport,
 * full-bleed, name beneath — designed, not the desktop grid squeezed (§6.4).
 *
 * Anchor ids come from the collection entry ids, which the homepage dish list
 * already links to: #branzino, #mango-caprese, #oxtail-arancini, #panna-cotta.
 *
 * Rooms follow `plateTone`: dark plates in ink, white plates in cream (§5.2).
 * Crops are the native 3:4 with nothing cut — every homepage crop is 4:5, so
 * no crop is ever reused.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageIntro from '@/components/layout/PageIntro.astro';
import Section from '@/components/layout/Section.astro';

const dishes = (await getCollection('dishes')).sort(
  (a, b) => a.data.order - b.data.order,
);

/**
 * Editorial scale, deliberately uneven (§7.4). The signature dish is widest
 * and sits alone; the rest step down. Data drives the room, this drives the
 * composition — a fifth dish falls back to the medium treatment.
 */
const LAYOUT: Record<string, { scale: 'lead' | 'wide' | 'medium' | 'inset'; side: 'left' | 'right' }> = {
  branzino: { scale: 'lead', side: 'left' },
  'mango-caprese': { scale: 'medium', side: 'right' },
  'oxtail-arancini': { scale: 'inset', side: 'left' },
  'panna-cotta': { scale: 'wide', side: 'right' },
};

const title = 'Gallery — From the Island Meets Italy Kitchen';
const description =
  'Jamaican soul. Italian tradition. Food by Chef Kenton Lowrie — whole branzino, mango caprese, oxtail arancini and lime & coconut panna cotta.';
---

<Base
  title={title}
  description={description}
  ogImage="/og/gallery.jpg"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Gallery', href: '/gallery' }]}
>
  <PageIntro title="From the Island Meets Italy Kitchen">
    <p class="prose">Jamaican soul. Italian tradition. Food by Chef Kenton Lowrie.</p>
  </PageIntro>

  {
    dishes.map((dish, i) => {
      const layout = LAYOUT[dish.id] ?? { scale: 'medium', side: i % 2 ? 'right' : 'left' };
      return (
        <Section tone={dish.data.plateTone === 'dark' ? 'ink' : 'cream'}>
          <figure
            class="dish"
            id={dish.id}
            data-scale={layout.scale}
            data-side={layout.side}
            data-reveal
          >
            <Image
              src={dish.data.image}
              alt={dish.data.alt}
              widths={[480, 640, 800, 1080]}
              sizes="(min-width: 900px) 60vw, 100vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              class="dish__img"
            />
            <figcaption class="dish__caption">
              <span class="dish__rule" aria-hidden="true" />
              <span class="dish__name display">{dish.data.name}</span>
            </figcaption>
          </figure>
        </Section>
      );
    })
  }
</Base>

<style>
  /* ── Mobile: one dish per viewport, full-bleed ──────────────────────── */

  .dish {
    margin: 0;
    /* Anchored from the homepage dish list — clear the fixed header. */
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .dish__img {
    width: 100vw;
    /* global.css caps every image at max-width:100%, which is the container's
       334px here — that silently clipped the bleed to the content width. The
       hero escapes it because its negative margin is on the figure; this one
       is on the image itself, so the cap has to be lifted explicitly. */
    max-width: none;
    /* Out to both edges: the Section's inner padding is cancelled here so a
       dish fills the screen the way §7.4 asks, without the page scrolling
       sideways (body has overflow-x: clip). */
    margin-inline: calc(var(--gutter) * -1);
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center;
  }

  .dish__caption { display: block; }

  .dish__rule {
    display: block;
    width: 100%;
    height: 1px;
    margin-block: clamp(1.25rem, 3vh, 1.75rem) clamp(0.9rem, 2vh, 1.25rem);
    background: var(--room-rule);
  }

  .dish__name {
    display: block;
    font-size: var(--step-2);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--room-text);
    text-wrap: balance;
  }

  /* ── Desktop: asymmetric editorial grid ─────────────────────────────── */

  @media (min-width: 900px) {
    .dish__img {
      width: 100%;
      max-width: 100%;
      margin-inline: 0;
    }

    /* Deliberately uneven widths. The branzino leads. */
    .dish[data-scale='lead'] { width: 72%; }
    .dish[data-scale='wide'] { width: 58%; }
    .dish[data-scale='medium'] { width: 46%; }
    .dish[data-scale='inset'] { width: 38%; }

    .dish[data-side='right'] { margin-inline-start: auto; }

    /* The lead dish gets its caption alongside rather than beneath, so the
       signature dish reads differently from the rest. */
    .dish[data-scale='lead'] {
      display: grid;
      grid-template-columns: 1fr minmax(12rem, 0.32fr);
      align-items: end;
      gap: clamp(1.5rem, 3vw, 2.5rem);
      width: 88%;
    }
    .dish[data-scale='lead'] .dish__rule { margin-block-start: 0; }
    .dish[data-scale='lead'] .dish__name { font-size: var(--step-1); }

    .dish[data-scale='inset'] .dish__name { font-size: var(--step-1); }
  }
</style>
