---
/**
 * Gallery (§7.4).
 *
 * Desktop is an asymmetric editorial grid, not four equal tiles: the branzino
 * is the signature dish and runs largest, the others step down and alternate
 * which side of the meeting line they sit on. Mobile is one dish per viewport,
 * full-bleed, name beneath — designed, not the desktop grid squeezed (§6.4).
 *
 * Anchor ids come from the collection entry ids, which the homepage dish list
 * already links to: #branzino, #mango-caprese, #oxtail-arancini, #panna-cotta.
 *
 * Rooms follow `plateTone`: dark plates in ink, white plates in cream (§5.2).
 * Crops are the native 3:4 with nothing cut — every homepage crop is 4:5, so
 * no crop is ever reused.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageIntro from '@/components/layout/PageIntro.astro';
import Section from '@/components/layout/Section.astro';

const dishes = (await getCollection('dishes')).sort(
  (a, b) => a.data.order - b.data.order,
);

/**
 * Editorial scale, deliberately uneven (§7.4). The signature dish is widest
 * and sits alone; the rest step down. Data drives the room, this drives the
 * composition — a fifth dish falls back to the medium treatment.
 */
const LAYOUT: Record<string, { scale: 'lead' | 'wide' | 'medium' | 'inset'; side: 'left' | 'right' }> = {
  branzino: { scale: 'lead', side: 'left' },
  'mango-caprese': { scale: 'medium', side: 'right' },
  'oxtail-arancini': { scale: 'inset', side: 'left' },
  'panna-cotta': { scale: 'wide', side: 'right' },
};

const title = 'Gallery — From the Island Meets Italy Kitchen';
const description =
  'Jamaican soul. Italian tradition. Food by Chef Kenton Lowrie — whole branzino, mango caprese, oxtail arancini and lime & coconut panna cotta.';
---

<Base
  title={title}
  description={description}
  ogImage="/og/gallery.jpg"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Gallery', href: '/gallery' }]}
>
  <PageIntro title="From the Island Meets Italy Kitchen">
    <p class="prose">Jamaican soul. Italian tradition. Food by Chef Kenton Lowrie.</p>
  </PageIntro>

  {
    dishes.map((dish, i) => {
      const layout = LAYOUT[dish.id] ?? { scale: 'medium', side: i % 2 ? 'right' : 'left' };
      return (
        <Section tone={dish.data.plateTone === 'dark' ? 'ink' : 'cream'}>
          <figure
            class="dish"
            id={dish.id}
            data-scale={layout.scale}
            data-side={layout.side}
            data-reveal
          >
            <Image
              src={dish.data.image}
              alt={dish.data.alt}
              widths={[480, 640, 800, 1080]}
              sizes="(min-width: 900px) 60vw, 100vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              class="dish__img"
            />
            <figcaption class="dish__caption">
              <span class="dish__rule" aria-hidden="true" />
              <span class="dish__name display">{dish.data.name}</span>
            </figcaption>
          </figure>
        </Section>
      );
    })
  }
</Base>

<style>
  /* ── Mobile: one dish per viewport, full-bleed ──────────────────────── */

  .dish {
    margin: 0;
    /* Anchored from the homepage dish list — clear the fixed header. */
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .dish__img {
    /* global.css caps every image at max-width:100%, which is the container's
       334px here — that silently clipped the bleed to the content width. The
       hero escapes it because its negative margin is on the figure; this one
       is on the image itself, so the cap has to be lifted explicitly. */
    max-width: none;
    /* Out to both edges: the Section's inner padding is cancelled here so a
       dish fills the screen the way §7.4 asks, without the page scrolling
       sideways (body has overflow-x: clip). Derived from the padding it is
       cancelling rather than from 100vw, which on Windows is a scrollbar
       wider than the page and bled 15px off the right of every dish. */
    width: calc(100% + var(--edge-x) * 2);
    margin-inline: calc(var(--edge-x) * -1);
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center;
  }

  .dish__caption { display: block; }

  /* The double hairline from the cookbook cover, not a generic rule. */
  .dish__rule {
    display: block;
    width: 100%;
    height: 3px;
    margin-block: clamp(1.25rem, 3vh, 1.75rem) clamp(0.9rem, 2vh, 1.25rem);
    border-block: 1px solid var(--room-rule);
  }

  .dish__name {
    display: block;
    font-size: var(--step-2);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--room-text);
    text-wrap: balance;
  }

  /* ── Desktop: asymmetric editorial grid ─────────────────────────────── */

  @media (min-width: 900px) {
    /* Every dish spans the full column and splits it: the photograph on its
       own side, the name in the facing column sitting on the picture's bottom
       edge. Previously only the lead did this and the rest were bare figures
       floated left or right — an `inset` dish at 38% left a 60%-wide, 600px-
       tall block of empty room beside it with nothing in it, which read as a
       layout that had failed rather than as space. The asymmetry §7.4 asks
       for now comes from how far the split moves, not from a void. */
    /* A dish is bounded by HEIGHT, not driven by width. These are 3:4
       portrait frames, so sizing them from the column made width and height
       rise together: pushed to 62% of a 1920 screen the lead photograph came
       out 1130x1507 — one and a half screens tall — and the page ran to seven
       viewport-heights for four pictures. You could never see a dish whole.

       A portrait photograph on a wide monitor cannot be both broad and wholly
       visible, and §5.2 rules out cropping these frames wide. Being wholly
       visible wins on the one page whose whole job is the food, so the margin
       either side is the honest consequence — and it is put to work: the
       photograph is anchored to the page edge and the name to the meeting
       line, so both edges of the composition are disciplined and the slack
       falls in the middle, between picture and caption, where a gap belongs.

       The column boundary is the meeting line, as in every other room. */
    .dish {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: end;
      width: 100%;
    }

    .dish__img {
      /* Fills its half of the page until the height cap bites, then holds. */
      width: min(100%, calc(var(--dish-h) * 3 / 4));
      max-width: 100%;
      margin-inline: 0;
    }

    /* Deliberately uneven, and every one of them fits on the screen. */
    .dish[data-scale='lead'] { --dish-h: min(86svh, 60rem); }
    .dish[data-scale='wide'] { --dish-h: min(78svh, 54rem); }
    .dish[data-scale='medium'] { --dish-h: min(72svh, 48rem); }
    .dish[data-scale='inset'] { --dish-h: min(66svh, 44rem); }

    .dish__caption {
      align-self: end;
      max-width: 26rem;
    }

    /* Entering from the left: picture against the left page edge, name across
       the line. Entering from the right, the mirror of it (§6.1). */
    .dish[data-side='left'] .dish__img {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
    }
    .dish[data-side='left'] .dish__caption {
      grid-column: 2;
      grid-row: 1;
      justify-self: start;
      margin-inline-start: clamp(1.75rem, 4vw, 3.5rem);
    }

    .dish[data-side='right'] .dish__img {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
    }
    .dish[data-side='right'] .dish__caption {
      grid-column: 1;
      grid-row: 1;
      justify-self: end;
      text-align: right;
      margin-inline-end: clamp(1.75rem, 4vw, 3.5rem);
    }

    .dish__rule { margin-block-start: 0; }
    .dish__name { font-size: var(--step-2); }

    /* The signature dish still reads differently: the largest frame and the
       only name set at display scale. */
    .dish[data-scale='lead'] .dish__name { font-size: var(--step-3); }
  }
</style>
