---
/**
 * Home (§7.1).
 *
 * Room sequence per §6.4: ink hero, ink brand introduction, cream food
 * feature, ink cookbook feature, cream chef introduction, ink media feature,
 * ink footer. Plate colour decides which room each photograph lands in.
 */
import Base from '@/layouts/Base.astro';
import Hero from '@/components/home/Hero.astro';
import BrandIntro from '@/components/home/BrandIntro.astro';
import FoodFeature from '@/components/home/FoodFeature.astro';
import CookbookFeature from '@/components/home/CookbookFeature.astro';
import ChefIntro from '@/components/home/ChefIntro.astro';
import MediaFeature from '@/components/home/MediaFeature.astro';
import { site } from '@/config/site';

const title = 'Island Meets Italy — Chef Kenton Lowrie';
const description =
  'Jamaican soul. Italian tradition. One culinary journey. The culinary brand of Chef Kenton Lowrie, and the debut cookbook Volume 1: Foundations of Flavor.';

/** Book, for the cookbook feature. Null config values are omitted, not
 *  emitted as empty strings — invalid structured data is worse than none. */
const bookSchema = {
  '@type': 'Book',
  name: site.book.fullTitle,
  author: { '@id': `${site.url}/#kenton` },
  publisher: site.book.publisher,
  bookFormat: 'https://schema.org/Hardcover',
  inLanguage: 'en',
  ...(site.book.pages ? { numberOfPages: site.book.pages } : {}),
  ...(site.book.isbn ? { isbn: site.book.isbn } : {}),
  ...(site.book.publicationDateISO
    ? { datePublished: site.book.publicationDateISO }
    : {}),
  /**
   * An Offer without a price is invalid, and invalid structured data is worse
   * than none (§12) — so the whole node is omitted until the hardcover is
   * costed, rather than emitting `price: null`.
   */
  ...(site.book.priceValue !== null
    ? {
        offers: {
          '@type': 'Offer',
          price: site.book.priceValue,
          priceCurrency: site.book.currency,
          ...(site.book.purchaseUrl ? { url: site.book.purchaseUrl } : {}),
        },
      }
    : {}),
};
---

<Base
  title={title}
  description={description}
  ogImage="/og/home.jpg"
  schema={[bookSchema]}
  headerOverlay
>
  <Hero />
  <BrandIntro />
  <FoodFeature />
  <CookbookFeature />
  <ChefIntro />
  <MediaFeature />
</Base>
